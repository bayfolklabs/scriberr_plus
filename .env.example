# Scriberr local config for a native Windows, CPU-only machine.
# Copy to .env (gitignored). config.Load() reads it via godotenv, and every value here
# is also inherited by the uv/python model processes.

# --- Server -----------------------------------------------------------------
# Loopback only, so the dev server isn't exposed on the LAN (and no firewall prompt).
# Use http://localhost:8080 in the browser: mic/screen capture need a secure context.
HOST=127.0.0.1
PORT=8080
# Keep development over plain http: production forces Secure cookies and breaks login.
APP_ENV=development
SECURE_COOKIES=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# --- Data paths (relative to the repo root; run the server from there) ------
DATABASE_PATH=data/scriberr.db
UPLOAD_DIR=data/uploads
TRANSCRIPTS_DIR=data/transcripts
TEMP_DIR=data/temp
WHISPERX_ENV=data/whisperx-env

# --- Models -----------------------------------------------------------------
# Which adapters to register and set up at startup (empty = all of them, as upstream).
# All: whisperx, parakeet, canary, voxtral, openai_whisper, pyannote, sortformer
# On this laptop: canary needs 8 GB+ RAM and a 6 GB download; voxtral needs ~19 GB RAM.
# parakeet/sortformer pull NeMo (heavy, unofficial on Windows). pyannote needs HF_TOKEN.
SCRIBERR_ADAPTERS=whisperx,openai_whisper

# CPU-only: make every adapter install CPU PyTorch wheels instead of CUDA (cu126).
PYTORCH_CUDA_VERSION=cpu
# Python model envs: pin the interpreter uv uses (avoids the Microsoft Store python stub).
UV_PYTHON=3.11
# Keep uv's managed Pythons and package cache outside %APPDATA%. Apps that run in an MSIX
# container (e.g. a terminal inside the Claude desktop app) get AppData writes redirected,
# which breaks uv's Python links. Absolute paths with forward slashes.
UV_PYTHON_INSTALL_DIR=C:/Users/<you>/.cache/uv/python
UV_CACHE_DIR=C:/Users/<you>/.cache/uv/cache
# Windows consoles default to cp1252; model scripts print UTF-8 transcript text.
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# One background transcription job at a time on a 4-core CPU.
QUEUE_WORKERS=1

# Optional
# OPENAI_API_KEY=
# HF_TOKEN=        # needed for PyAnnote diarization models

# Note: LOG_LEVEL is read before .env is loaded; set it in the shell instead:
#   $env:LOG_LEVEL = 'debug'
